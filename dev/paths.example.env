# Copy to .dreams.local.env in the repository root and set this machine's paths.
DREAMS_DISC1=C:\path\to\disc1\extracted
DREAMS_DISC2=C:\path\to\disc2\extracted
DREAMS_WATCOM=C:\path\to\watcom
DREAMS_WORK_ROOT=C:\path\to\dreams-work
DREAMS_GHIDRA_ROOT=C:\path\to\ghidra

# Optional overrides. By default, extraction uses DREAMS_WORK_ROOT\extract,
# and ordinary toolkit output uses the repository's out\ directory.
# DREAMS_EXTRACT=C:\path\to\dreams-work\extract
# DREAMS_OUT=C:\path\to\output
# DREAMS_NA_GAME_TOOL=C:\path\to\na_game_tool.exe
