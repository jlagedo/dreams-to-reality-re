# Copy to .dreams.local.env in the repository root and set this machine's paths.
DREAMS_DISC1=C:\path\to\disc1\extracted
DREAMS_DISC2=C:\path\to\disc2\extracted
# Optional retail installation/cache tree for local comparisons (not a disc source).
# DREAMS_INSTALL_ROOT=C:\CRYO\DREAMS
DREAMS_WATCOM=C:\path\to\watcom
# Watcom compilers for matching decompilation. Unset, they default to
# DREAMS_WATCOM\wc110\11.0 (the Windows builds) and DREAMS_WATCOM\wc106\watcom10.6
# (the runtime the DOS builds link).
# DREAMS_WATCOM_COMPILER=C:\path\to\watcom\wc110\11.0
# DREAMS_WATCOM_COMPILER_106=C:\path\to\watcom\wc106\watcom10.6
DREAMS_WORK_ROOT=C:\path\to\dreams-work
DREAMS_GHIDRA_ROOT=C:\path\to\ghidra

# Optional overrides. Extraction defaults to DREAMS_WORK_ROOT\extract;
# ordinary toolkit output uses the repository's out\ directory.
# DREAMS_EXTRACT=C:\path\to\dreams-work\extract
# DREAMS_OUT=C:\path\to\output
# DREAMS_NA_GAME_TOOL=C:\path\to\na_game_tool.exe
# pcrecomp clone for the static recompilation experiment (recomp/README.md);
# defaults to DREAMS_OUT\recomp\pcrecomp.
# DREAMS_PCRECOMP=C:\path\to\pcrecomp
