# Copy to .dreams.local.env in the repository root and set this machine's paths.
# Extracted disc trees: the executables are lifted from disc 1.
DREAMS_DISC1=C:\path\to\disc1\extracted
DREAMS_DISC2=C:\path\to\disc2\extracted
# Retail installation tree (CRYO\DREAMS) that the recompiled game reads its data from.
DREAMS_INSTALL_ROOT=C:\CRYO\DREAMS
# Ghidra installation: function bounds, names and decompilation.
DREAMS_GHIDRA_ROOT=C:\path\to\ghidra
# Watcom reference files and compilers (difftest and matching decompilation).
DREAMS_WATCOM=C:\path\to\watcom
# Unset, the compilers default to DREAMS_WATCOM\wc110\11.0 (the Windows builds)
# and DREAMS_WATCOM\wc106\watcom10.6 (the runtime the DOS builds link).
# DREAMS_WATCOM_COMPILER=C:\path\to\watcom\wc110\11.0
# DREAMS_WATCOM_COMPILER_106=C:\path\to\watcom\wc106\watcom10.6
# The July 1997 demo's DREAMS directory: the build extracts the Dreams Editor
# menu that Develop shows from its DREAMS.EXE (SHA-256 checked; spec 008
# phase 1). Unset, the build keeps the retail two-node menu.
DREAMS_WIP_DIR=C:\path\to\DREAMS_WIP_PCJ\DREAMS

# Optional overrides. Output defaults to the repository's out\ directory.
# DREAMS_OUT=C:\path\to\output
# pcrecomp clone (recomp/README.md); defaults to DREAMS_OUT\recomp\pcrecomp.
# DREAMS_PCRECOMP=C:\path\to\pcrecomp
