      * @param isAddress If true, identifier is treated as an address; otherwise as a name
      * @return Map containing success status and detailed information
      */
+    /**
+     * Persist the current program to its Ghidra project file.
+     *
+     * Every other mutation tool only opens an undo-able transaction in memory;
+     * without this the whole session is lost when Ghidra closes. Added locally
+     * for the Dreams project - see docs/re-setup.md.
+     */
+    public Map<String, Object> saveProgram() {
+        Map<String, Object> result = new HashMap<>();
+        result.put("success", false);
+
+        if (currentProgram == null) {
+            result.put("error", "No program loaded");
+            return result;
+        }
+
+        try {
+            boolean hadUnsaved = currentProgram.isChanged();
+            ghidra.framework.model.DomainFile df = currentProgram.getDomainFile();
+            if (df == null) {
+                result.put("error", "Program has no domain file (not in a project?)");
+                return result;
+            }
+            if (df.isReadOnly()) {
+                result.put("error", "Program is read-only");
+                return result;
+            }
+            df.save(ghidra.util.task.TaskMonitor.DUMMY);
+            result.put("success", true);
+            result.put("program", currentProgram.getName());
+            result.put("path", df.getPathname());
+            result.put("hadUnsavedChanges", hadUnsaved);
+        } catch (Exception e) {
+            result.put("error", "Save failed: " + e.getMessage());
+        }
+        return result;
+    }
+
