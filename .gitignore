*.bin
*.cue
*.iso
*.img
*.ccd
*.sub
*.mds
*.mdf
*.nrg

# Extracted disc trees (any directory named like these, at any depth)
extracted/
Disc-Image-Disk-*/
disc1/
disc2/
game/
assets/

