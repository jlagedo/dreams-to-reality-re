# (listed here only as a reminder; not ignored)

# ---------------------------------------------------------------------------
# Local config and editors
# ---------------------------------------------------------------------------
dreams.local.toml
.dreams.local.env
.env
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Allowlist: small reference artefacts we DO want in the repo.
# Add narrowly, and only for things that are ours, not Cryo's.
# ---------------------------------------------------------------------------
!docs/**/*.md
!tests/data/*.hex

# ---------------------------------------------------------------------------
# Ghidra / reverse engineering
#
# A Ghidra project is an opaque binary blob that git cannot merge and that
# embeds copies of the analysed executables. Treat it as a BUILD ARTIFACT:
# regenerate it from the discs with tools/ghidra-import.ps1.
#
# The SOURCE of truth for our analysis is re/ - exported symbols, struct
# definitions and notes, all diffable text. Commit those.
# ---------------------------------------------------------------------------
ghidra/
*.rep/
*.gpr
*.lock
*.ghidra
ghidra_*.log
.ghidra/
ghidra-server/

# Ghidra extension build output
dist/
build/
.gradle/

# Local Ghidra install (should live outside the repo anyway)
ghidra_*_PUBLIC/
